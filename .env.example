# Base de données Postgres
# Local (Docker) : docker run --name solimouv-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=solimouv -p 5432:5432 -d postgres:16
DATABASE_URL=postgres://postgres:dev@localhost:5432/solimouv

# Niveau de logs
RUST_LOG=solimouv=debug,tower_http=info,sqlx=warn

# Adresse d'écoute (laisser par défaut en local)
LEPTOS_SITE_ADDR=0.0.0.0:3000
