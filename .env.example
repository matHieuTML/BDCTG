# Base de données Postgres
# Local (Docker) : docker run --name solimouv-pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=solimouv -p 5433:5432 -d postgres:16
# (port 5433 pour éviter conflit avec un Postgres natif déjà installé)
DATABASE_URL=postgres://postgres:dev@localhost:5433/solimouv

# Niveau de logs
RUST_LOG=solimouv=debug,tower_http=info,sqlx=warn

# Adresse d'écoute (laisser par défaut en local)
LEPTOS_SITE_ADDR=0.0.0.0:3000
